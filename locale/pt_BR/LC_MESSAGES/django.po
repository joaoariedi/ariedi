msgid "Hello, I'm <strong>João Ariedi</strong>."
msgstr "Olá, eu sou <strong>João Ariedi</strong>."

msgid "Engineering leader · Builder of AI agent harnesses ·<br> Researcher on AI and the competences of technical work."
msgstr "Líder de engenharia · Construtor de harnesses para agentes de IA ·<br> Pesquisador sobre IA e as competências do trabalho técnico."

msgid "Based in Brazil, remote."
msgstr "No Brasil, em trabalho remoto."

msgid "I lead <strong>engineering at scale</strong>"
msgstr "Eu lidero <strong>engenharia em escala</strong>"

msgid "I build <strong>the harnesses that let AI agents build software</strong>"
msgstr "Eu construo <strong>os harnesses que permitem a agentes de IA construir software</strong>"

